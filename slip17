index.js
document.addEventListener("deviceready", onDeviceReady, false);

function onDeviceReady() {
    console.log("Device Ready");
}

// Create Contact
function createContact() {
    var name = document.getElementById("name").value;
    var phone = document.getElementById("phone").value;

    var contact = navigator.contacts.create();
    contact.displayName = name;

    var phoneNumbers = [];
    phoneNumbers[0] = new ContactField('mobile', phone, true);
    contact.phoneNumbers = phoneNumbers;

    contact.save(function() {
        alert("Contact Saved");
    }, function() {
        alert("Error Saving Contact");
    });
}

// Search Contact
function searchContact() {
    var name = document.getElementById("name").value;

    var options = new ContactFindOptions();
    options.filter = name;
    options.multiple = true;

    var fields = ["displayName"];

    navigator.contacts.find(fields, function(contacts) {
        if (contacts.length > 0) {
            alert("Contact Found: " + contacts[0].displayName);
        } else {
            alert("No Contact Found");
        }
    }, function() {
        alert("Search Failed");
    }, options);
}

// Clone Contact
function cloneContact() {
    var contact = navigator.contacts.create({"displayName": "Clone User"});
    var cloned = contact.clone();
    cloned.save(function() {
        alert("Contact Cloned");
    }, function() {
        alert("Clone Failed");
    });
}

// Delete Contact
function deleteContact() {
    var name = document.getElementById("name").value;

    var options = new ContactFindOptions();
    options.filter = name;
    options.multiple = true;

    navigator.contacts.find(["displayName"], function(contacts) {
        if (contacts.length > 0) {
            contacts[0].remove(function() {
                alert("Contact Deleted");
            }, function() {
                alert("Delete Failed");
            });
        } else {
            alert("No Contact Found");
        }
    }, function() {
        alert("Search Failed");
    }, options);
}
