package com.example.armstrong;

import android.os.Bundle;
import android.view.View;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText getnum;
    Button check;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_main);

        getnum = findViewById(R.id.getnum);
        check = findViewById(R.id.check);

        check.setOnClickListener(new View.OnClickListener() {
            @Override
            public void onClick(View v) {
                int num = Integer.parseInt(getnum.getText().toString());
                int temp = num, sum = 0, rem;

                while (temp > 0) {
                    rem = temp % 10;
                    sum = sum + (rem * rem * rem);
                    temp = temp / 10;
                }

                if (sum == num) {
                    Toast.makeText(MainActivity.this,
                            "Armstrong Number", Toast.LENGTH_SHORT).show();
                } else {
                    Toast.makeText(MainActivity.this,
                            "Not Armstrong Number", Toast.LENGTH_SHORT).show();
                }
            }
        });
    }
}

