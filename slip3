package com.example.phonenumberexamine; 
 
import android.os.Bundle; 
import android.widget.Button; 
import android.widget.EditText; 
import android.widget.TextView; 

import androidx.appcompat.app.AppCompatActivity; 
 
public class MainActivity extends AppCompatActivity { 
 
    EditText phoneInput; 
    Button validateBtn; 
    TextView validationResult; 
 
    final String[] VALID_AREA_CODES = {"040", "041", "050", "0400", "044"}; 
 
    @Override     
    protected void onCreate(Bundle savedInstanceState) {         
        super.onCreate(savedInstanceState);         
        setContentView(R.layout.activity_main); 
 
        phoneInput = findViewById(R.id.phoneInput);         
        validateBtn = findViewById(R.id.validateBtn);         
        validationResult = findViewById(R.id.validationResult); 
 
        validateBtn.setOnClickListener(v -> { 
            String phoneNumber = phoneInput.getText().toString().trim(); 
 
            if (!phoneNumber.matches("\\d+")) {                 
                validationResult.setText("  Only numbers allowed.");                 
                return; 
            } 
 
            String matchedAreaCode = null; 
 
            // Try to match area codes             
            for (String code : VALID_AREA_CODES) {                 
                if (phoneNumber.startsWith(code)) {                     
                    matchedAreaCode = code; 
                    break; 
                } 
            } 
 
            if (matchedAreaCode == null) {                 
                validationResult.setText("  Invalid area code.");                 
                return; 
            } 
 
            int totalDigits = phoneNumber.length(); 
 
            if (totalDigits >= 6 && totalDigits <= 8) { 
                validationResult.setText("  Valid phone number."); 
            } else { 
                validationResult.setText("  Phone number should be 6–8 digits long (including area code)."); 
            } 
        }); 
    } 
}
